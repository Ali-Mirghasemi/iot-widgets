{
  "name": "iot-widget-studio-react",
  "private": false,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:lib",
    "preview": "vite preview",
    "screenshots": "node scripts/capture-widgets.mjs",
    "screenshots:install": "playwright install chromium",
    "screenshots:full": "node scripts/full-screenshots.mjs",
    "build:app": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "pack:lib": "npm run build:lib && npm pack",
    "test:layout": "node scripts/test-dashboard-layout.mjs"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "description": "Reusable React + MUI IoT widget library with adaptive sizes, bilingual EN/FA support, and multiple visual themes.",
  "main": "./dist/library/index.js",
  "module": "./dist/library/index.js",
  "types": "./dist/library/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js",
      "default": "./dist/library/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "INTEGRATION.md",
    "docs"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/material": "^7.0.0",
    "@mui/icons-material": "^7.0.0"
  }
}
