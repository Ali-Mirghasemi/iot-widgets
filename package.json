{
  "name": "iot-widget-studio-react",
  "private": false,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:lib",
    "preview": "vite preview",
    "screenshots": "node scripts/capture-widgets.mjs",
    "screenshots:install": "playwright install chromium",
    "screenshots:full": "node scripts/full-screenshots.mjs",
    "build:app": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepare": "npm run build:lib",
    "pack:lib": "npm run build:lib && npm pack",
    "test:layout": "node scripts/test-dashboard-layout.mjs",
    "test:qa": "node scripts/test-qa-config.mjs && node scripts/test-qa-resources.mjs && node scripts/test-qa-parallel.mjs",
    "test:adaptive": "node scripts/test-adaptive.mjs",
    "test": "npm run test:layout && npm run test:adaptive && npm run test:qa && npm run test:responsive",
    "qa:responsive": "node scripts/qa-responsive.mjs",
    "test:responsive": "node scripts/test-responsive.mjs",
    "test:selective": "node --test scripts/test-selective-renderer-imports.mjs"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "description": "Reusable React + MUI IoT widget library with adaptive sizes, bilingual EN/FA support, and multiple visual themes.",
  "main": "./dist/library/index.js",
  "module": "./dist/library/index.js",
  "types": "./dist/library/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js",
      "default": "./dist/library/index.js"
    },
    "./visual-core": {
      "types": "./dist/widgets/renderers/WidgetVisualCore.d.ts",
      "import": "./dist/widgets/renderers/WidgetVisualCore.js"
    },
    "./renderers/material": {
      "types": "./dist/widgets/themes/MaterialVisuals.d.ts",
      "import": "./dist/widgets/themes/MaterialVisuals.js"
    },
    "./renderers/flat": {
      "types": "./dist/widgets/themes/FlatVisuals.d.ts",
      "import": "./dist/widgets/themes/FlatVisuals.js"
    },
    "./renderers/minimal": {
      "types": "./dist/widgets/themes/MinimalVisuals.d.ts",
      "import": "./dist/widgets/themes/MinimalVisuals.js"
    },
    "./renderers/gaming": {
      "types": "./dist/widgets/themes/GamingVisuals.d.ts",
      "import": "./dist/widgets/themes/GamingVisuals.js"
    },
    "./renderers/ios": {
      "types": "./dist/widgets/themes/IOSVisuals.d.ts",
      "import": "./dist/widgets/themes/IOSVisuals.js"
    },
    "./renderers/glass": {
      "types": "./dist/widgets/themes/GlassVisuals.d.ts",
      "import": "./dist/widgets/themes/GlassVisuals.js"
    },
    "./renderers/studio": {
      "types": "./dist/widgets/themes/StudioVisuals.d.ts",
      "import": "./dist/widgets/themes/StudioVisuals.js"
    },
    "./renderers/horizon": {
      "types": "./dist/widgets/themes/StudioVisuals.d.ts",
      "import": "./dist/widgets/themes/StudioVisuals.js"
    },
    "./renderers/industrial": {
      "types": "./dist/widgets/themes/ProcessVisuals.d.ts",
      "import": "./dist/widgets/themes/ProcessVisuals.js"
    },
    "./renderers/tactile": {
      "types": "./dist/widgets/themes/TactileVisuals.d.ts",
      "import": "./dist/widgets/themes/TactileVisuals.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "INTEGRATION.md",
    "docs"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/material": "^7.0.0",
    "@mui/icons-material": "^7.0.0"
  }
}
